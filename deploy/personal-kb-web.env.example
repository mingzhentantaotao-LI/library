# Copy to /etc/personal-kb-web.env on the server and chmod 600.
# Do not commit the real file with secrets.

KB_AUTH_REQUIRED=1
KB_AUTH_USERNAME=admin
KB_AUTH_PASSWORD=change-this-password
KB_SESSION_SECRET=change-this-random-secret

# Keep these defaults while serving directly on port 80.
# For HTTPS behind nginx, change to KB_HOST=127.0.0.1 and KB_PORT=8080.
KB_HOST=0.0.0.0
KB_PORT=80

# Optional OpenAI-compatible AI provider. Leave empty to use local rules.
KB_AI_API_KEY=
KB_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
KB_AI_MODEL=gpt-5.5
KB_AI_TIMEOUT_SECONDS=20
